# Copy to .env and edit before running docker compose up.

# Operator credential for the panel API and UI.
# Generate one with: openssl rand -hex 32
# Required: the panel refuses to start without it.
PANEL_ADMIN_TOKEN=change-me-to-a-long-random-value

# Image to run. Pin a released tag in production instead of latest.
PANEL_IMAGE=ghcr.io/uio-o/smart-gateway:latest

# Where the panel listens on the host. Loopback by default so the panel must be
# fronted by the operator's own reverse proxy.
PANEL_BIND=127.0.0.1
PANEL_PORT=8090

# Port pool handed out to relay routes. Must match the panel settings.
RELAY_PORT_START=3001
RELAY_PORT_END=3100


# Only needed for the optional local-relay profile. Create the node in the
# panel first, then paste the token it issues.
# RELAY_NODE_NAME=local-relay
# RELAY_AGENT_TOKEN=sg_replace_me
TZ=UTC
