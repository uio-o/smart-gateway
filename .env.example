# Copy to .env and edit before running docker compose up.

# Operator credential for the panel API and UI.
# Generate one with: openssl rand -hex 32
# Required: the panel refuses to start without it.
PANEL_ADMIN_TOKEN=change-me-to-a-long-random-value

# Image tags to run. Pin a released version in production instead of latest.
# The panel and the agent are separate images, so they version independently.
PANEL_VERSION=latest
AGENT_VERSION=latest

# Where the panel listens on the host. Loopback by default so the panel must be
# fronted by the operator's own reverse proxy.
PANEL_BIND=127.0.0.1
PANEL_PORT=8090

# Port pool handed out to relay routes. Must match the panel settings.
RELAY_PORT_START=3001
RELAY_PORT_END=3100

# Both are only needed for the optional local-relay profile, which does not
# start with a plain `docker compose up -d`. Create the node in the panel first,
# then paste the token it issues:
#   RELAY_NODE_NAME=local-relay
#   RELAY_AGENT_TOKEN=sg_replace_me
#   docker compose --profile local-relay up -d
# Leaving them out is fine; the relay container refuses to start without them.

TZ=UTC
